      {
        "name": "split_receipt",
        "title": "Split booking (Beleg aufteilen)",
        "description": "Same as 'Beleg aufteilen' in the app: books one receipt onto several parts (categories/VAT rates) while the receipt and its file stay one document. Replaces existing parts. The gross sum must equal the receipt gross (±0.02). Never changes the receipt status.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Receipt id."
            },
            "parts": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "amount_gross": {
                    "type": "number",
                    "description": "Gross amount of this part."
                  },
                  "amount_net": {
                    "description": "Net amount; if omitted it is calculated from gross and VAT rate.",
                    "type": "number"
                  },
                  "vat_rate": {
                    "description": "VAT rate in percent; defaults to the receipt's rate.",
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "category": {
                    "description": "One of the user's existing categories; defaults to the receipt category.",
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "description": "Description of this part.",
                    "type": "string"
                  },
                  "is_private": {
                    "description": "Mark this part as private (shown as tag 'Privat' in exports).",
                    "type": "boolean"
                  }
                },
                "required": [
                  "amount_gross"
                ],
                "additionalProperties": false
              },
              "description": "Parts of the split booking."
            }
          },
          "required": [
            "id",
            "parts"
          ]
        },
        "outputSchema": null
      },
