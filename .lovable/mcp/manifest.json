          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "from": {
              "description": "Start receipt date (YYYY-MM-DD).",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "to": {
              "description": "End receipt date (YYYY-MM-DD).",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "vendor": {
              "description": "Filter by vendor name (partial match).",
              "type": "string",
              "minLength": 1
            },
            "status": {
              "description": "Filter by receipt status, e.g. completed.",
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "description": "Filter by one exact existing tag name.",
              "type": "string",
              "minLength": 1
            },
            "limit": {
              "default": 25,
              "description": "Maximum number of receipts to return.",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
