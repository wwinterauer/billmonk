      {
        "name": "update_receipt",
        "title": "Correct receipt data",
        "description": "Correct extracted fields of a receipt. On approved receipts only category, tags and receipt_date may be changed, all other fields are locked. \"Keine Rechnung\" (no_invoice: true, or category \"Keine Rechnung\") marks documents that are not invoices, e.g. Booking payout or Airbnb booking overviews: the receipt keeps its data but is left out of all expense/VAT totals, dashboards and the tax/DATEV export, and is skipped in other exports when \"Keine Rechnung ausschließen\" is selected; amount_gross may be set to null for such entries. This does not approve the receipt; use approve_receipt for that. Always double-check the id matches the document you compared. The optional tags list replaces all tag assignments and accepts only existing tag names. If gross and VAT rate change but net is not given, net and VAT amount are recalculated.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Receipt id."
            },
            "vendor": {
              "description": "Legal vendor name.",
              "type": "string",
              "minLength": 1
            },
            "vendor_brand": {
              "description": "Vendor brand name.",
              "type": "string",
              "minLength": 1
            },
            "receipt_date": {
              "description": "Receipt date YYYY-MM-DD.",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "invoice_number": {
              "description": "Invoice number.",
              "type": "string"
            },
            "amount_gross": {
              "description": "Gross amount. null clears it (intended for \"Keine Rechnung\" entries without an amount).",
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "amount_net": {
              "description": "Net amount.",
              "type": "number"
            },
            "vat_amount": {
              "description": "VAT amount.",
              "type": "number"
            },
            "vat_rate": {
              "description": "VAT rate in percent.",
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "category": {
              "description": "One of the user's existing categories.",
              "type": "string",
              "minLength": 1
            },
            "description": {
              "description": "Short description.",
              "type": "string"
            },
            "skonto_amount": {
              "description": "Manual cash discount (Skonto) in EUR deducted at payment; 0 removes it. Original invoice amounts stay unchanged.",
              "type": "number",
              "minimum": 0
            },
            "skonto_percent": {
              "description": "Manual cash discount in percent of gross; 0 removes it.",
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "no_invoice": {
              "description": "true marks the receipt as \"Keine Rechnung\" exactly like the app (category \"Keine Rechnung\" plus no-receipt flag). false only clears the flag; set a new category to leave \"Keine Rechnung\".",
              "type": "boolean"
            },
            "tags": {
              "description": "Complete list of existing tag names for this receipt. Replaces all current tags; [] removes every tag. Unknown names are rejected and never created.",
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "id"
          ]
        },
        "outputSchema": null
